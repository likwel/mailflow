// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum TemplateType {
  PERSONAL   // créé par l'utilisateur
  SYSTEM     // fourni par la plateforme
}


// ─── Plan (limites par tier) ─────────────────────────
model Plan {
  id               String   @id @default(cuid())
  name             String   @unique // FREE, PRO, BUSINESS, CUSTOM
  displayName      String            // "Gratuit", "Pro", "Business"

  // ── Tarification ──────────────────────────────────
  price            Float    @default(0)      // Prix mensuel en Ar
  priceAnnual      Float    @default(0)      // Prix mensuel si facturé annuellement (-20%)

  // ── Quotas emails ─────────────────────────────────
  emailsPerMonth   Int      @default(100)
  maxBulkSend      Int      @default(0)      // 0 = désactivé, -1 = illimité

  // ── Quotas API & templates ────────────────────────
  apiKeysMax       Int      @default(1)      // -1 = illimité
  templatesMax     Int      @default(3)      // -1 = illimité

  // ── Quotas contacts & listes ──────────────────────
  contactsMax      Int      @default(200)    // -1 = illimité
  listsMax         Int      @default(2)      // -1 = illimité

  // ── Quotas workflows ──────────────────────────────
  workflowsMax     Int      @default(0)      // 0 = désactivé, -1 = illimité

  // ── Fonctionnalités ───────────────────────────────
  webhooks         Boolean  @default(false)
  logRetentionDays Int      @default(7)      // Rétention des logs en jours

  // ── Metadata ──────────────────────────────────────
  features         String[]                  // Affiché sur la page pricing
  isCustom         Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]
  customPlans      CustomPlan[]
}

// ─── Plan personnalisé ────────────────────────────────
model CustomPlan {
  id               String   @id @default(cuid())
  userId           String   @unique
  basePlanId       String
  emailsPerMonth   Int
  maxBulkSend      Int
  price            Float
  features         String[]
  status           PlanStatus @default(PENDING)
  requestedAt      DateTime @default(now())
  approvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  basePlan         Plan     @relation(fields: [basePlanId], references: [id])
}

enum PlanStatus {
  PENDING    // En attente d'approbation
  APPROVED   // Approuvé
  REJECTED   // Rejeté
  ACTIVE     // Actif
}

// ─── User ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String?          // ← ajouter cette ligne
  googleId      String?  @unique
  avatar        String?
  role          Role     @default(USER)
  planId        String?  // ← Remplace l'enum Plan
  emailsUsed    Int      @default(0)
  emailsReset   DateTime @default(now()) // date du dernier reset mensuel
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  plan          Plan?    @relation(fields: [planId], references: [id])
  customPlan    CustomPlan?
  apiKeys       ApiKey[]
  templates     Template[]
  emails        EmailLog[]
  sessions      Session[]
  contacts  Contact[]
  lists     List[]
  Workflows Workflow[]
}

// ─── Session (OAuth) ──────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId   String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── API Key ──────────────────────────────────────────

model ApiKey {
  id        String   @id @default(cuid())
  userId   String
  name      String
  key       String   @unique  // hashed
  keyPrefix String             // 8 premiers chars pour l'affichage (ex: "sk_live_Ab3d...")
  isActive  Boolean  @default(true)
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Template ─────────────────────────────────────────

model Template {
  id        String       @id @default(cuid())
  userId   String?      // null si SYSTEM
  name      String
  subject   String
  htmlBody  String
  textBody  String?
  type      TemplateType @default(PERSONAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails EmailLog[]  // ← ajouter cette ligne
}

// ─── Email Log ────────────────────────────────────────

model EmailLog {
  id          String      @id @default(cuid())
  userId     String
  templateId  String?
  to          String[]                    // destinataires
  cc          String[]                    @default([])
  bcc         String[]                    @default([])
  subject     String
  htmlBody    String
  textBody    String?
  status      EmailStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isBulk      Boolean     @default(false)
  bulkGroupId String?     // pour regrouper les envois en lot

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id])
}

// ─── Rate Limit ───────────────────────────────────────

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique  // ex: "api_key:abc123" ou "user:cuid123"
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// prisma/schema.prisma

model Contact {
  id            String   @id @default(uuid())
  email         String   @unique
  firstName     String?
  lastName      String?
  phone         String?
  company       String?
  tags          String[] // ["vip", "newsletter", etc.]
  customFields  Json?    // Champs personnalisés flexibles
  status        ContactStatus @default(ACTIVE)
  source        String?  // "manual", "import", "api", "form"
  
  // Relations
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists         ContactListMember[]
  campaigns     CampaignRecipient[]
  events        ContactEvent[]
  
  // Métadonnées
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastEmailSent DateTime?
  emailsSent    Int      @default(0)
  emailsOpened  Int      @default(0)
  emailsClicked Int      @default(0)
  
  @@index([userId])
  @@index([email])
  @@index([status])
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  BLOCKED
}

model List {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts    ContactListMember[]
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
}

model ContactListMember {
  id         String   @id @default(uuid())
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  listId     String
  list       List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())
  
  @@unique([contactId, listId])
  @@index([contactId])
  @@index([listId])
}

model ContactEvent {
  id         String   @id @default(uuid())
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type       EventType
  metadata   Json?
  createdAt  DateTime @default(now())
  
  @@index([contactId])
  @@index([type])
  @@index([createdAt])
}

enum EventType {
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_BOUNCED
  UNSUBSCRIBED
  SUBSCRIBED
  CONTACT_CREATED
  CONTACT_UPDATED
  LIST_ADDED
  LIST_REMOVED
}

model CampaignRecipient {
  id         String   @id @default(uuid())
  campaignId String
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status     RecipientStatus @default(PENDING)
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  
  @@unique([campaignId, contactId])
  @@index([contactId])
  @@index([campaignId])
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("draft")   // draft | active | inactive
  template    String   @default("blank")   // blank | welcome | reengagement | abandoned

  // ── Anciens champs conservés ──────────────────────
  trigger     Json     @default("{}")      // config déclencheur (ancien)
  actions     Json     @default("[]")      // actions (ancien)
  stats       Json?                        // stats simples (ancien)

  // ── Nouveaux champs canvas n8n ────────────────────
  nodes       Json     @default("[]")      // nœuds du canvas
  edges       Json     @default("[]")      // connexions entre nœuds

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  WorkflowExecution[]

  @@index([userId])
}

model WorkflowExecution {
  id           String    @id @default(cuid())
  workflowId   String
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status       String    @default("running")  // running | success | error
  nodeStatuses Json      @default("{}")       // { nodeId: "running" | "success" | "error" }
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([workflowId])
}